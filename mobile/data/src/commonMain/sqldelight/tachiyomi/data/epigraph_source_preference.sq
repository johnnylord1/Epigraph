-- Per comic extension setting or novel plugin setting (their entity IDs start with the type):
-- the value this device and the paired Core last agreed on.
-- fingerprint is "<valueType>:<json>" (sets sorted); core_server_version is 0 before the Core
-- has a record. Cleared with the replica, so a new pairing starts from a fresh comparison.
CREATE TABLE IF NOT EXISTS epigraph_source_preference_agreement(
    scope_id TEXT NOT NULL,
    entity_id TEXT NOT NULL,
    fingerprint TEXT NOT NULL,
    core_server_version INTEGER NOT NULL DEFAULT 0 CHECK(core_server_version >= 0),
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(scope_id, entity_id)
);

selectSourcePreferenceAgreements:
SELECT entity_id, fingerprint, core_server_version
FROM epigraph_source_preference_agreement
WHERE scope_id = :scopeId;

upsertSourcePreferenceAgreement:
INSERT INTO epigraph_source_preference_agreement(scope_id, entity_id, fingerprint, core_server_version, updated_at)
VALUES (:scopeId, :entityId, :fingerprint, :coreServerVersion, :updatedAt)
ON CONFLICT(scope_id, entity_id) DO UPDATE SET
    fingerprint = excluded.fingerprint,
    core_server_version = excluded.core_server_version,
    updated_at = excluded.updated_at;

deleteAllSourcePreferenceAgreements:
DELETE FROM epigraph_source_preference_agreement;
