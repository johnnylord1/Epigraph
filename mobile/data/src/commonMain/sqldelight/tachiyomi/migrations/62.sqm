-- EPUB and PDF chapters gain their own read and bookmark flags, kept apart from the one synced
-- reading position. Both tables stay on this device: the sync contract has no per-chapter book
-- command. No row is seeded here because a chapter index depends on the publication's structure;
-- a book without a reading state derives it from its position the next time it opens.
CREATE TABLE IF NOT EXISTS local_book_chapter_state(
    book_id TEXT NOT NULL,
    chapter_index INTEGER NOT NULL,
    read_override INTEGER,
    bookmark INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY(book_id, chapter_index),
    FOREIGN KEY(book_id) REFERENCES local_books(book_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS local_book_reading_state(
    book_id TEXT NOT NULL PRIMARY KEY,
    read_through INTEGER NOT NULL DEFAULT 0,
    local_locator_json TEXT,
    FOREIGN KEY(book_id) REFERENCES local_books(book_id) ON DELETE CASCADE
);
