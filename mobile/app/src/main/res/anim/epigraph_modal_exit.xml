<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN.md §9: modals leave faster than they arrive, shrinking only slightly. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <scale
        android:duration="@integer/dur_quick"
        android:fromXScale="1.0" android:toXScale="0.96"
        android:fromYScale="1.0" android:toYScale="0.96"
        android:interpolator="@interpolator/ease_exit"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha
        android:duration="@integer/dur_quick"
        android:fromAlpha="1.0" android:toAlpha="0.0"
        android:interpolator="@interpolator/ease_exit" />
</set>
