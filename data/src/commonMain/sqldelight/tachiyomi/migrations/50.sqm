-- Core versions before server-qualified comic IDs were accepted could permanently receipt an
-- otherwise valid rejection. Retrying the same clientMutationId would only replay that receipt,
-- so re-key only this exact failure and identity shape once. Genuinely invalid or ambiguous
-- Legacy rows remain untouched for explicit recovery.
CREATE TABLE aethon_sync_outbox_rekey_50 (
    sequence INTEGER NOT NULL PRIMARY KEY,
    old_client_mutation_id TEXT NOT NULL,
    new_client_mutation_id TEXT NOT NULL UNIQUE
);

INSERT INTO aethon_sync_outbox_rekey_50(
    sequence,
    old_client_mutation_id,
    new_client_mutation_id
)
SELECT
    sequence,
    client_mutation_id,
    lower(hex(randomblob(16)))
FROM aethon_sync_outbox
WHERE status = 'ERROR'
  AND last_error = 'blocked:INVALID_COMIC_ID'
  AND entity_type IN ('comic.history', 'comic.page_bookmark')
  AND entity_id GLOB 'suwayomi:server:*:profile:*:manga:*';

UPDATE aethon_sync_outbox
SET client_mutation_id = (
        SELECT new_client_mutation_id
        FROM aethon_sync_outbox_rekey_50
        WHERE aethon_sync_outbox_rekey_50.sequence = aethon_sync_outbox.sequence
    ),
    payload_json = replace(
        payload_json,
        '"clientMutationId":"' || client_mutation_id || '"',
        '"clientMutationId":"' || (
            SELECT new_client_mutation_id
            FROM aethon_sync_outbox_rekey_50
            WHERE aethon_sync_outbox_rekey_50.sequence = aethon_sync_outbox.sequence
        ) || '"'
    ),
    status = 'PENDING',
    next_attempt_at = 0,
    last_error = NULL,
    in_flight_at = NULL,
    lease_until = NULL
WHERE sequence IN (SELECT sequence FROM aethon_sync_outbox_rekey_50);

DROP TABLE aethon_sync_outbox_rekey_50;
