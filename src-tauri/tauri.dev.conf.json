{
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420"
  },
  "app": {
    "windows": [
      {
        "title": "Aethon",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "backgroundColor": "#090d0b",
        "center": true,
        "devtools": true
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "binaries/aethon-syncd"
    ]
  }
}
