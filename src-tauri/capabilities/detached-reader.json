{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "detached-reader",
  "description": "Detached manga and book reader windows. They run no application commands of their own; the main window relays the few reads they need, so only window controls, events and HTTP to the reading server are allowed here.",
  "windows": ["detached-reader-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-is-maximized",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    },
    "http:allow-fetch"
  ]
}
