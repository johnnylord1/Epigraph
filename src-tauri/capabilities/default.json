{
  "$schema": "../gen/schemas/capabilities.json",
  "capabilities": [
    {
      "identifier": "desktop-default",
      "description": "Default desktop permissions for Aethon, including Discord RPC.",
      "windows": ["main"],
      "platforms": ["windows", "macOS", "linux"],
      "permissions": [
        "core:default",
        "shell:allow-open",
        "shell:allow-kill",
        "shell:allow-spawn",
        "shell:allow-execute",
        "core:window:allow-minimize",
        "core:window:allow-unminimize",
        "core:window:allow-maximize",
        "core:window:allow-unmaximize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-close",
        "core:window:allow-start-dragging",
        "core:window:allow-set-focus",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen",
        "core:window:allow-is-maximized",
        "core:window:allow-is-minimized",
        "core:window:allow-inner-size",
        "core:window:allow-outer-size",
        "core:window:allow-inner-position",
        "core:window:allow-outer-position",
        "core:window:allow-scale-factor",
        "updater:default",
        "updater:allow-check",
        "updater:allow-download-and-install",
        "process:default",
        "process:allow-restart",
        "http:default",
        "http:allow-fetch",
        "drpc:default",
        "drpc:allow-is-running",
        "drpc:allow-spawn-thread",
        "drpc:allow-destroy-thread",
        "drpc:allow-set-activity",
        "drpc:allow-clear-activity"
      ]
    },
    {
      "identifier": "mobile-default",
      "description": "Default Android bootstrap permissions for Aethon without desktop-only Discord RPC.",
      "windows": ["main"],
      "platforms": ["android"],
      "permissions": [
        "core:default",
        "shell:allow-open",
        "shell:allow-kill",
        "shell:allow-spawn",
        "shell:allow-execute",
        "core:window:allow-minimize",
        "core:window:allow-unminimize",
        "core:window:allow-maximize",
        "core:window:allow-unmaximize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-close",
        "core:window:allow-start-dragging",
        "core:window:allow-set-focus",
        "core:window:allow-set-fullscreen",
        "core:window:allow-is-fullscreen",
        "core:window:allow-is-maximized",
        "core:window:allow-is-minimized",
        "core:window:allow-inner-size",
        "core:window:allow-outer-size",
        "core:window:allow-inner-position",
        "core:window:allow-outer-position",
        "core:window:allow-scale-factor",
        "updater:default",
        "updater:allow-check",
        "updater:allow-download-and-install",
        "process:default",
        "process:allow-restart",
        "http:default",
        "http:allow-fetch"
      ]
    }
  ]
}
