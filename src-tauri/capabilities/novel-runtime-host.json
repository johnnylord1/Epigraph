{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "novel-runtime-host",
  "description": "Minimal permissions for the hidden novels plugin runtime host. All runtime IPC must stay explicitly whitelisted.",
  "windows": ["novel-runtime-host"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.hardcover.app/**" },
        { "url": "https://api.hardcover.app/*" },
        { "url": "http://*:*/*" },
        { "url": "https://*:*/*" }
      ]
    },
    "http:allow-fetch"
  ]
}
