# --- Build Artifacts ---
node_modules/
dist/
dist-tauri/
target/
bin/
out/

# --- Nix ---
.direnv/
result
result-*

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*.local

# --- IDEs & OS ---
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Tauri specific ---
src-tauri/target/
src-tauri/gen/

# --- Flatpak build artifacts ---
build-dir/
repo/
dist/
packaging/frontend-dist.tar.gz
*.flatpak
.flatpak-builder/

# --- Local generated artifacts ---
.local-run/
.local-smoke/
local-*.png
tmp/
src-tauri/target-local/
*.actual.png

# --- Staged sidecar binaries (platform-specific, never commit) ---
src-tauri/binaries/

# --- Epigraph Mobile ---
# mobile/ is a separate Gradle build with its own mobile/.gitignore; the desktop
# patterns above must not hide Android sources such as extension/repo/ packages.
!mobile/**/repo/
!mobile/**/bin/
!mobile/**/out/
!mobile/**/tmp/
!mobile/**/dist/
!mobile/**/target/
