{
  "name": "epigraph",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project shell-jsdom",
    "test:browser": "vitest run --project browser-components",
    "test:suwayomi-certification": "node --test scripts/certify-suwayomi-release.test.mjs scripts/certify-suwayomi-migration.test.mjs scripts/certify-suwayomi-extension-workflows.test.mjs",
    "test:suwayomi-workflows": "node scripts/certify-suwayomi-extension-workflows.mjs",
    "test:source-contracts": "node --test scripts/certify-suwayomi-extension-workflows.test.mjs && vitest run --project unit src/lib/manga/runtime/sourceContract.test.ts src/lib/manga/runtime/compatibility.test.ts src/lib/manga/runtime/transport.test.ts --maxWorkers=1 --minWorkers=1",
    "test:source-compatibility-reports": "vitest run --project unit src/lib/manga/runtime/diagnostics.test.ts src/lib/manga/runtime/extensionCompatibility.test.ts src/lib/manga/runtime/extensionUpdateCoordinator.test.ts src/lib/manga/runtime/observedCompatibility.test.ts src/lib/manga/runtime/health.test.ts --maxWorkers=1 --minWorkers=1",
    "release:certify-data": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-local-data-release-certification.ps1",
    "release:test-data-contracts": "node --test scripts/certify-local-data.test.mjs",
    "release:smoke-native-viewports": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-native-viewport-smoke.ps1",
    "release:certify-integrations": "node scripts/certify-integration-contracts.mjs",
    "release:certify-source-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-source-runtime.ps1",
    "release:smoke-live": "node scripts/smoke-live-integrations.mjs",
    "release:check-bundles": "node scripts/check-bundle-budgets.mjs",
    "release:check-navigation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-native-viewport-smoke.ps1 -NodeScript check-navigation-performance.mjs",
    "release:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release.ps1",
    "suwayomi:prepare-bundle:windows": "node scripts/prepare-suwayomi-bundle.mjs",
    "theme:generate-builtins": "node scripts/generate-builtin-themes.mjs",
    "theme:check-builtins": "node scripts/generate-builtin-themes.mjs --check",
    "theme:audit-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-theme-runtime-audit.ps1",
    "theme:test-runtime-audit": "node --test scripts/theme-runtime-audit.test.mjs",
    "theme:validate-promotion": "node scripts/validate-theme-promotion.mjs",
    "certify:suwayomi": "node scripts/certify-suwayomi-release.mjs",
    "syncd:prepare-sidecar": "node ./scripts/prepare-syncd-sidecar.mjs",
    "syncd:prepare-sidecar:release": "node ./scripts/prepare-syncd-sidecar.mjs --release",
    "tauri": "tauri",
    "tauri:build": "pnpm suwayomi:prepare-bundle:windows && pnpm syncd:prepare-sidecar:release && tauri build --config src-tauri/tauri.conf.json",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:dev:gate": "tauri dev --config src-tauri/tauri.dev.conf.json --no-watch"
  },
  "dependencies": {
    "@noble/ciphers": "^2.1.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.3.1",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "epubjs": "^0.3.93",
    "fast-xml-parser": "^5.3.0",
    "htmlparser2": "^12.0.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "long": "^5.3.2",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.6.205",
    "phosphor-svelte": "^3.1.0",
    "protobufjs": "^8.0.1",
    "qrcode": "^1.5.4",
    "tauri-plugin-drpc": "^1.0.3"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.20.0",
    "@inlang/plugin-m-function-matcher": "2.1.0",
    "@inlang/plugin-message-format": "4.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/svelte": "^5.3.1",
    "@vitest/browser": "2.1.8",
    "jsdom": "^29.0.1",
    "playwright": "^1.59.1",
    "selenium-webdriver": "^4.42.0",
    "svelte": "^5.0.0",
    "svelte-check": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "2.1.8"
  }
}
